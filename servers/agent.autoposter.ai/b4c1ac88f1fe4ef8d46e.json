            },
            "type": "array"
          },
          "content": {
            "description": "Base text content of the post.",
            "type": "string"
          },
          "files": {
            "description": "Optional files generated in chat or uploaded by user to attach to the post.",
            "items": {
              "$ref": "#/$defs/MediaFile"
            },
            "type": "array"
          },
          "mediaIds": {
            "description": "Optional list of existing media IDs from workspace media library (from autoposter_list_media).",
