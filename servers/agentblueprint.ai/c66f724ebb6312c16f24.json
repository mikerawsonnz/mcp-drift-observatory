  "tools": [
    {
      "annotations": {
        "destructiveHint": false,
        "openWorldHint": false,
        "readOnlyHint": true
      },
      "description": "Lists the ten everyday jobs in Agent Blueprint's measured agent cost benchmark (2 November 2026): what each job was, how big its input was, and the typical and worst-case tokens and dollar cost measured over five runs each on Claude Code and Codex. Use it to find the benchmark job closest to a task someone wants an agent to do, before estimating that task's cost.",
      "inputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "agent": {
            "description": "Only show one agent's measurements. Leave out to show both.",
            "enum": [
              "claude",
              "codex"
            ],
            "type": "string"
          }
        },
        "type": "object"
      },
      "name": "list_benchmark_jobs",
      "title": "List measured agent jobs"
    },
    {
      "annotations": {
        "destructiveHint": false,
        "openWorldHint": false,
        "readOnlyHint": true
      },
      "description": "Estimates the tokens and dollar cost of an AI agent task from the measured benchmark job closest to it. For jobs where cost grows with how much the agent reads, give the size of the real input and it scales the reading part while keeping the agent's fixed overhead. Returns a typical and a budget (worst-case) figure per run and, if runs per month are given, per month. Uses the benchmark-day prices unless current prices are passed. The result is an estimate from small test jobs, not a quote.",
      "inputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "agent": {
            "description": "Which measured agent to base the estimate on.",
            "enum": [
              "claude",
              "codex"
            ],
            "type": "string"
          },
          "job": {
            "description": "The closest benchmark job id, from list_benchmark_jobs.",
            "enum": [
              "sql",
              "refactor",
              "bughunt",
              "analysis",
              "clean",
              "feature",
              "triage200",
              "replies",
              "corpus",
              "longdoc"
            ],
            "type": "string"
          },
          "prices": {
            "description": "Current model prices in US dollars per million tokens. Leave out to use the benchmark-day prices.",
            "properties": {
              "cached_input_per_million": {
                "minimum": 0,
                "type": "number"
              },
              "input_per_million": {
                "minimum": 0,
                "type": "number"
              },
              "output_per_million": {
                "minimum": 0,
                "type": "number"
              }
            },
            "required": [
              "input_per_million",
              "cached_input_per_million",
              "output_per_million"
            ],
            "type": "object"
          },
          "runs_per_month": {
            "description": "How many times a month the job runs.",
            "exclusiveMinimum": 0,
            "maximum": 10000000,
            "type": "integer"
          },
          "your_size": {
            "description": "Size of the real input in the job's unit (words, or rows for the clean job). Ignored for jobs that don't scale.",
            "exclusiveMinimum": 0,
            "maximum": 1000000000,
            "type": "number"
          }
        },
        "required": [
          "job",
          "agent"
        ],
        "type": "object"
      },
      "name": "estimate_agent_cost",
      "title": "Estimate an agent task's cost"
    },
    {
      "annotations": {
        "destructiveHint": false,
        "openWorldHint": false,
        "readOnlyHint": true
      },
      "description": "Checks the structure of a one-page agent summary written from Agent Blueprint's template (https://agentblueprint.ai/agent-one-page-template): all eight sections present and in order, a stage line, every rule ending in \"Enforced by:\" or \"Not enforced:\", every Open item naming who decides, no template placeholders left, and length within one page. It checks shape only, not whether the answers are right. The text is checked and returned findings only; it is not stored.",
      "inputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "markdown": {
            "description": "The full one-page summary as Markdown.",
            "maxLength": 60000,
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "markdown"
        ],
        "type": "object"
      },
      "name": "check_agent_one_page",
      "title": "Check a one-page agent summary"
    },
    {
      "annotations": {
        "destructiveHint": false,
        "openWorldHint": false,
        "readOnlyHint": true
      },
      "description": "Turns an agent's own inventory of its connections into Agent Blueprint's one-page access map: a single offline HTML page showing what the agent can read and change, who has to approve, its riskiest powers, and what could be trimmed. The agent supplies the inventory from its own tool list; this tool only draws it. Returns the HTML for the person to save, such as my-agent-blueprint.html. The inventory is not stored. The field guide is at https://agentblueprint.ai/draw.md.",
      "inputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "agent": {
            "properties": {
              "model": {
                "maxLength": 80,
                "type": "string"
              },
              "name": {
                "maxLength": 80,
                "type": "string"
              },
              "product": {
                "maxLength": 80,
                "type": "string"
              }
            },
            "required": [
              "name"
            ],
            "type": "object"
          },
          "checks": {
            "properties": {
              "commands": {
                "properties": {
                  "evidence": {
                    "maxLength": 300,
                    "type": "string"
                  },
                  "status": {
                    "enum": [
                      "yes",
                      "none_found",
                      "unsure"
                    ],
                    "type": "string"
                  }
                },
                "required": [
                  "status",
                  "evidence"
                ],
                "type": "object"
              },
              "delete": {
                "properties": {
                  "evidence": {
                    "maxLength": 300,
                    "type": "string"
                  },
                  "status": {
                    "enum": [
                      "yes",
                      "none_found",
                      "unsure"
                    ],
                    "type": "string"
                  }
                },
                "required": [
                  "status",
                  "evidence"
                ],
                "type": "object"
              },
              "messages": {
                "properties": {
                  "evidence": {
                    "maxLength": 300,
                    "type": "string"
                  },
                  "status": {
                    "enum": [
                      "yes",
                      "none_found",
                      "unsure"
                    ],
                    "type": "string"
                  }
                },
                "required": [
                  "status",
                  "evidence"
                ],
                "type": "object"
              },
              "money": {
                "properties": {
                  "evidence": {
                    "maxLength": 300,
                    "type": "string"
                  },
                  "status": {
                    "enum": [
                      "yes",
                      "none_found",
                      "unsure"
                    ],
                    "type": "string"
                  }
                },
                "required": [
                  "status",
                  "evidence"
                ],
                "type": "object"
              },
              "secrets": {
                "properties": {
                  "evidence": {
                    "maxLength": 300,
                    "type": "string"
                  },
                  "status": {
                    "enum": [
                      "yes",
                      "none_found",
                      "unsure"
                    ],
                    "type": "string"
                  }
                },
                "required": [
                  "status",
                  "evidence"
                ],
                "type": "object"
              }
            },
            "required": [
              "commands",
              "messages",
              "delete",
              "money",
              "secrets"
            ],
            "type": "object"
          },
          "connections": {
            "items": {
              "properties": {
                "asks": {
                  "type": [
                    "boolean",
                    "null"
                  ]
                },
                "basis": {
                  "enum": [
                    "declared",
                    "judged"
                  ],
                  "type": "string"
                },
                "changes": {
                  "items": {
                    "maxLength": 200,
                    "type": "string"
                  },
                  "maxItems": 300,
                  "type": "array"
                },
                "icon": {
                  "enum": [
                    "mail",
                    "chat",
                    "calendar",
                    "code",
                    "files",
                    "terminal",
                    "web",
                    "doc",
                    "data",
                    "money",
                    "plug"
                  ],
                  "type": "string"
                },
                "name": {
                  "maxLength": 40,
                  "type": "string"
                },
                "reads": {
                  "items": {
                    "maxLength": 200,
                    "type": "string"
                  },
                  "maxItems": 300,
                  "type": "array"
                },
                "risk": {
                  "enum": [
                    "normal",
                    "high"
                  ],
                  "type": "string"
                },
                "unsure": {
                  "items": {
                    "maxLength": 200,
                    "type": "string"
                  },
                  "maxItems": 300,
                  "type": "array"
                }
              },
              "required": [
                "name",
                "icon",
                "basis",
                "asks",
                "risk",
                "reads",
                "changes",
                "unsure"
              ],
              "type": "object"
            },
            "maxItems": 60,
            "minItems": 1,
            "type": "array"
          },
          "drawn": {
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
            "type": "string"
          },
          "trim": {
            "items": {
              "properties": {
                "kind": {
                  "enum": [
                    "duplicate",
                    "overlap"
