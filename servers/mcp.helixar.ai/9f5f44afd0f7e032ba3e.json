            "type": "string"
          },
          "mode": {
            "default": "quick",
            "enum": [
              "quick",
              "deep"
            ],
            "type": "string"
          },
          "target": {
            "description": "MCP server URL or raw manifest JSON string",
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "target"
        ],
        "type": "object"
      },
      "name": "helixar_inspect_mcp"
    },
    {
