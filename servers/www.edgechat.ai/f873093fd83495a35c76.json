    {
      "annotations": {
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false,
        "readOnlyHint": true,
        "title": "Fetch an Edgepedia article"
      },
      "description": "Read an encyclopedia article in full: one Edgepedia article as Markdown with its citations, by a `search` result's id. Returns id, title, text, url, and metadata (topic path, license, credit). A `topic:` id lists that topic's parent, narrower topics, and articles, 120 a page; `topic:root` is the top of the tree, `topic:geo` the geography tree. `citations: false` gives [n] markers instead of inline source links. Show the `credit` line with any text you quote.",
      "icons": [
        {
          "mimeType": "image/png",
          "sizes": [
            "1130x1130"
          ],
          "src": "https://www.edgechat.ai/assets/edgechat-chestnut-orange-logo-v2.png"
        }
      ],
      "inputSchema": {
        "properties": {
          "chunks": {
            "description": "true = the text as paragraphs with stable ids, in `chunks`.",
            "type": "boolean"
          },
          "citations": {
            "description": "Default true. false = [n] markers instead of inline source links; the numbered reference list stays.",
            "type": "boolean"
          },
          "cite": {
            "description": "Add a reference in this format (csl, bibtex, ris, apa, mla, chicago, harvard).",
            "enum": [
              "csl",
              "bibtex",
              "ris",
              "apa",
              "mla",
              "chicago",
              "harvard"
            ],
            "type": "string"
          },
          "cursor": {
            "description": "Where to continue, from a cut text's `next_cursor`.",
            "type": "string"
          },
          "format": {
            "description": "The text as plain text, HTML, JSON-LD, or Turtle instead of Markdown.",
            "enum": [
              "text",
              "html",
              "jsonld",
              "turtle"
            ],
            "type": "string"
          },
          "id": {
            "description": "The id of a search result (the last part of the article's address, such as \"mount-fuji\", or a topic's \"topic:…\" id).",
            "type": "string"
          },
          "ids": {
            "description": "More ids to fetch with `id` in one call, up to 10 in all.",
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "length": {
            "description": "snippet or lead for a short text; full (default) for the whole article.",
            "enum": [
              "snippet",
              "lead",
              "full"
            ],
            "type": "string"
          },
          "links": {
            "description": "Add the articles linking here (in), the links it makes (out), or both.",
            "enum": [
              "in",
              "out",
              "both"
            ],
            "type": "string"
          },
          "links_page": {
            "description": "With links \"in\" or \"both\": which 30 articles linking here, from 1.",
            "minimum": 1,
            "type": "integer"
          },
          "max_tokens": {
            "description": "Cut the text at a section boundary to about this many tokens; pass `next_cursor` as `cursor` for the rest.",
            "type": "integer"
          },
          "outline": {
            "description": "true = add the list of the article's headings.",
            "type": "boolean"
          },
          "page": {
            "description": "A topic only: which page of its articles, from 1.",
            "type": "integer"
          },
          "query": {
            "description": "Only the 3 passages that best match these words, each with a `cite_url`.",
            "type": "string"
          },
          "quote": {
            "description": "A sentence from the article, or a chunk id: adds a `cite_url` that opens the page at it.",
            "type": "string"
          },
          "section": {
            "description": "Only this section, by its heading (\"Etymology\", \"History\").",
            "type": "string"
          },
          "tables": {
            "description": "true = add the article's tables as JSON and CSV.",
            "type": "boolean"
          }
        },
        "required": [
          "id"
        ],
        "type": "object"
      },
      "name": "fetch",
      "outputSchema": {
        "anyOf": [
          {
            "required": [
