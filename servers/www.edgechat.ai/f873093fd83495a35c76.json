        "title": "Search Edgepedia"
      },
      "description": "Search an encyclopedia for facts about a person, place, thing, event, or concept: Edgepedia, over 300k articles with citations. Pass the subject's name (\"Mount Fuji\", \"photosynthesis\"), not a question; other names and misspellings match, and when no title matches, articles whose text does follow, marked `match: fulltext`. Returns results with id, title, url, and preview text, plus a `topic:` result when the query names a topic (\"painters\"); pass an id to `fetch`. `limit` and `page` reach further results.",
      "icons": [
        {
          "mimeType": "image/png",
          "sizes": [
            "1130x1130"
          ],
          "src": "https://www.edgechat.ai/assets/edgechat-chestnut-orange-logo-v2.png"
        }
      ],
      "inputSchema": {
        "properties": {
          "first": {
            "description": "true = only the best match.",
            "type": "boolean"
          },
          "limit": {
            "description": "Results a page, 1 to 30 (default 10).",
            "maximum": 30,
            "minimum": 1,
            "type": "integer"
          },
          "page": {
            "description": "Which page of results, from 1.",
            "minimum": 1,
            "type": "integer"
          },
          "query": {
            "description": "The name of a subject, or words from an article title.",
            "type": "string"
          },
          "sort": {
            "description": "central = the most-linked subjects first.",
            "enum": [
              "relevance",
              "central"
            ],
            "type": "string"
          },
          "topic": {
            "description": "Only articles under this topic id (as `fetch` topic:… names it, without \"topic:\").",
            "type": "string"
          }
        },
        "required": [
          "query"
        ],
        "type": "object"
      },
      "name": "search",
