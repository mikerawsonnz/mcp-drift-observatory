            "description": "The article's permanent id (ep…); `fetch` takes it, and it outlives an address change.",
            "type": "string"
          },
          "id": {
            "type": "string"
          },
          "metadata": {
            "type": "object"
          },
          "moved_from": {
            "description": "The id asked for, when the article has since moved; store `id` or `canonical_id` instead.",
            "type": "string"
          },
          "results": {
            "description": "With `ids`: one entry per id, in order: that fetch's answer, or { id, error: { code, message } }.",
            "items": {
