                    ],
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ],
                "description": "Engine confidence for this run"
              },
              "ensName": {
                "description": "ENS name for the address, when known",
                "type": [
                  "string",
                  "null"
                ]
              },
              "reportUrl": {
                "description": "Link to the full report on the Probity dashboard",
                "type": "string"
              },
              "score": {
                "description": "Signed reputation score from -100 to +100. Lower is worse.",
                "type": "number"
              },
              "screenedAt": {
                "description": "When this screen ran (ISO-8601)",
                "type": "string"
              },
              "screeningId": {
                "description": "The rsr_... id of this run",
                "type": "string"
              },
              "transactionCount": {
                "description": "Number of transactions analysed",
                "type": "integer"
              }
            },
            "required": [
              "screeningId",
              "address",
              "ensName",
              "score",
              "bandCode",
              "band",
