      "description": "Compare two completed screens by their screeningId and see what changed. Costs zero credits. Two runs of the same address show why the reputation score moved. Two different addresses show a side by side. Returns each run score, band, and confidence, a reason level diff, and the score change broken into its drivers. Small differences between runs of one address can be normal variation rather than a data change.",
      "execution": {
        "taskSupport": "forbidden"
      },
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "additionalProperties": false,
        "properties": {
          "runIdA": {
            "description": "First screeningId (rsr_...). Must be a completed screen you own.",
            "type": "string"
          },
          "runIdB": {
            "description": "Second screeningId (rsr_...). Must be a completed screen you own.",
            "type": "string"
          }
        },
        "required": [
          "runIdA",
          "runIdB"
        ],
        "type": "object"
      },
      "name": "compare_screening_runs",
      "outputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "additionalProperties": false,
        "properties": {
          "compositionDiff": {
            "description": "Which score drivers differ between the runs",
            "items": {
              "additionalProperties": false,
              "properties": {
                "change": {
                  "enum": [
                    "appeared",
                    "strengthened",
                    "weakened",
                    "removed"
                  ],
                  "type": "string"
                },
                "group": {
                  "type": "string"
                },
                "label": {
                  "type": "string"
                },
                "side": {
                  "enum": [
                    "raising",
                    "lowering"
                  ],
                  "type": "string"
                },
                "widthPctA": {
                  "type": "number"
                },
                "widthPctB": {
                  "type": "number"
                }
              },
              "required": [
                "group",
                "label",
                "side",
                "change",
                "widthPctA",
                "widthPctB"
              ],
              "type": "object"
            },
            "type": "array"
          },
          "mode": {
            "description": "temporal_delta when both runs are the same address, else side_by_side",
            "enum": [
              "temporal_delta",
              "side_by_side"
            ],
            "type": "string"
          },
          "reasonDiff": {
            "additionalProperties": false,
            "description": "What changed between the two runs at the reason level",
            "properties": {
              "added": {
                "description": "Reasons present in runA but not runB",
                "items": {
                  "additionalProperties": false,
                  "properties": {
                    "code": {
                      "type": "string"
                    },
                    "factor": {
                      "type": "string"
                    },
                    "message": {
                      "type": "string"
                    },
                    "severity": {
                      "$ref": "#/properties/runA/properties/confidence/anyOf/0"
                    }
                  },
                  "required": [
                    "code",
                    "factor",
                    "severity",
                    "message"
                  ],
                  "type": "object"
                },
                "type": "array"
              },
              "changed": {
                "description": "Reasons in both runs whose severity changed from runB to runA",
                "items": {
                  "additionalProperties": false,
                  "properties": {
                    "code": {
                      "type": "string"
                    },
                    "factor": {
                      "type": "string"
                    },
                    "from": {
                      "$ref": "#/properties/runA/properties/confidence/anyOf/0"
                    },
                    "message": {
                      "type": "string"
                    },
                    "to": {
                      "$ref": "#/properties/runA/properties/confidence/anyOf/0"
                    }
                  },
                  "required": [
                    "code",
                    "factor",
                    "from",
                    "to",
                    "message"
                  ],
                  "type": "object"
                },
                "type": "array"
              },
              "removed": {
                "description": "Reasons present in runB but not runA",
                "items": {
                  "$ref": "#/properties/reasonDiff/properties/added/items"
                },
                "type": "array"
              }
            },
            "required": [
              "added",
              "removed",
              "changed"
            ],
            "type": "object"
          },
          "runA": {
            "additionalProperties": false,
            "properties": {
              "address": {
                "description": "The screened address",
                "type": "string"
              },
              "band": {
                "description": "Reputation band, e.g. Low Risk",
                "type": "string"
              },
              "bandCode": {
                "description": "Band identifier, e.g. LOW_RISK",
                "type": "string"
              },
              "confidence": {
                "anyOf": [
