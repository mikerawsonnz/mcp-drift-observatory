      "description": "Propose a monitoring check for the user to review in Myriade.\n\nThis creates a PROPOSAL, never an active check: nothing runs until a\ndatabase owner or org admin accepts it in the app. The SQL is test-run\nonce under your governance context to validate it.\n\nContract for ``check_sql``: it MUST return rows ONLY when something is\nwrong (zero rows = healthy) and use relative time (``now() - interval``),\nnever absolute dates. Minimum cadence is 5 minutes. Names are unique per\ndatabase — read myriade_monitoring_overview before proposing a\nnear-duplicate.\n",
      "inputSchema": {
        "properties": {
          "check_sql": {
            "description": "SQL returning zero rows when healthy, rows when wrong",
            "maxLength": 20000,
            "minLength": 1,
            "title": "Check Sql",
            "type": "string"
          },
          "database_id": {
            "description": "UUID of the database",
            "format": "uuid",
            "title": "Database Id",
            "type": "string"
          },
          "description": {
            "default": "",
            "description": "One sentence, prospective tense: \"Trips when <condition> (baseline ~X)\"",
            "maxLength": 2000,
            "title": "Description",
            "type": "string"
          },
          "group_name": {
            "anyOf": [
              {
                "maxLength": 255,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Cluster to file the check under (reuse an existing group's exact name), or omit to leave it unfiled",
            "title": "Group Name"
          },
          "interval_minutes": {
            "default": 60,
            "description": "Cadence in minutes (minimum 5)",
            "minimum": 5,
            "title": "Interval Minutes",
            "type": "integer"
          },
          "name": {
            "description": "Short human-readable name (unique per database)",
            "maxLength": 255,
            "minLength": 1,
            "title": "Name",
            "type": "string"
          },
          "severity": {
            "default": "MEDIUM",
            "description": "Severity raised when the check trips",
            "enum": [
              "LOW",
              "MEDIUM",
              "HIGH",
              "CRITICAL"
            ],
            "title": "Severity",
            "type": "string"
          }
        },
        "required": [
          "database_id",
          "name",
          "check_sql"
