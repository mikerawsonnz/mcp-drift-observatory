    {
      "annotations": {
        "destructiveHint": true,
        "idempotentHint": false,
        "openWorldHint": false,
        "readOnlyHint": false
      },
      "description": "Triage an alert (requires manage access: database owner or org admin).\n\n- ``resolve``: the underlying problem is handled or gone.\n- ``acknowledge``: keep it standing with a ``statement`` of what is\n  happening — only for a situation that may worsen.\n- ``dismiss``: false positive / expected; refused while the check still\n  trips (it would just respawn).\n- ``snooze``: silence for ``hours`` with a ``statement``; reopens by itself\n  if the check still trips afterwards.\n- ``reopen``: send a parked alert back to \"needs action\" with a\n  ``statement`` of what is no longer covered.\n",
      "inputSchema": {
        "properties": {
          "action": {
            "description": "Transition to apply to the alert",
            "enum": [
              "resolve",
              "acknowledge",
              "dismiss",
              "snooze",
              "reopen"
            ],
            "title": "Action",
            "type": "string"
          },
          "alert_id": {
            "description": "UUID of the alert",
            "format": "uuid",
            "title": "Alert Id",
            "type": "string"
          },
          "hours": {
            "anyOf": [
              {
                "maximum": 168,
                "minimum": 1,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Snooze window in hours (1-168). Required for snooze.",
            "title": "Hours"
          },
          "note": {
            "anyOf": [
              {
                "maxLength": 2000,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Optional note appended to the alert details (resolve, dismiss)",
            "title": "Note"
          },
          "statement": {
            "anyOf": [
              {
                "maxLength": 500,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "One SHORT present-tense plain-text sentence (~120 chars, no Markdown) shown as the alert headline. Required for acknowledge, snooze and reopen.",
            "title": "Statement"
          }
        },
        "required": [
          "alert_id",
          "action"
        ],
        "title": "triage_alertArguments",
        "type": "object"
      },
