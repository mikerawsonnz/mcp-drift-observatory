      "description": "Execute a read-only SQL query against a database.\n\nWrite operations (INSERT, UPDATE, DELETE, DROP, etc.) are blocked.\nReturns up to 50 rows of results with column metadata. Successful\nqueries are saved in Myriade; the response's `query_id` can be\nreplayed later with myriade_get_query_results without resending SQL.\n",
      "inputSchema": {
        "properties": {
          "database_id": {
            "description": "UUID of the database",
            "format": "uuid",
            "title": "Database Id",
            "type": "string"
          },
          "sql": {
            "description": "Read-only SQL query (writes are blocked)",
            "maxLength": 20000,
            "minLength": 1,
            "title": "Sql",
            "type": "string"
          },
          "title": {
            "anyOf": [
              {
                "maxLength": 255,
                "minLength": 1,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Optional name for the saved query, shown in Myriade",
            "title": "Title"
          }
        },
        "required": [
          "database_id",
          "sql"
        ],
        "title": "queryArguments",
        "type": "object"
      },
      "name": "myriade_query",
      "outputSchema": {
        "properties": {
          "result": {
            "title": "Result",
            "type": "string"
          }
        },
        "required": [
          "result"
        ],
        "title": "queryOutput",
        "type": "object"
      }
    },
    {
      "annotations": {
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false,
        "readOnlyHint": true
      },
      "description": "Re-execute a saved Myriade query and return fresh results.\n\nThe query's SQL always re-runs under the caller's governance policies\n(table permissions, column masking) — results are never served from\nMyriade's cached snapshot.\n\nPrefer this over myriade_query for recurring metrics (dashboards,\ncockpits): the SQL stays governed in Myriade instead of travelling\nthrough prompts. Write statements are blocked. Returns up to 50 rows\nwith column metadata, same shape as myriade_query.\n",
      "inputSchema": {
        "properties": {
          "query_id": {
            "description": "UUID of a saved Myriade query (from a Myriade query link, e.g. in myriade_ask responses)",
            "format": "uuid",
            "title": "Query Id",
            "type": "string"
          }
        },
        "required": [
          "query_id"
        ],
        "title": "get_query_resultsArguments",
        "type": "object"
      },
      "name": "myriade_get_query_results",
      "outputSchema": {
        "properties": {
          "result": {
            "title": "Result",
            "type": "string"
          }
        },
        "required": [
          "result"
        ],
        "title": "get_query_resultsOutput",
        "type": "object"
      }
    },
