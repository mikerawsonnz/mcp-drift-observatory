              "number",
              "string"
            ]
          },
          "budgetMin": {
            "description": "Optional minimum budget in dollars, such as 20 or 20.00.",
            "type": [
              "number",
              "string"
            ]
          },
          "category": {
            "description": "Optional category. One of: Sales, Customer Support, Automotive, Marketing, Operations, Finance, Healthcare, Real Estate, Software Engineering, Other.",
