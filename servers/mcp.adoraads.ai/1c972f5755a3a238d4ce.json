            "description": "Product category filter (e.g., 'serum', 'moisturizer', 'cleanser', 'sunscreen')",
            "type": "string"
          },
          "concern": {
            "description": "Primary skin concern (e.g., 'acne', 'aging', 'hyperpigmentation')",
            "type": "string"
