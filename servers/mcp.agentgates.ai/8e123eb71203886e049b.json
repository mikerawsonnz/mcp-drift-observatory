    {
      "annotations": {
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": true,
        "readOnlyHint": true,
        "title": "Price one machine (the x402 offer)"
      },
      "description": "Gets the exact price of one machine without paying: sends the create request with no payment and returns the API's HTTP 402 offer, one leg per network, each with the amount in USDC, the address it is paid to, the token, how long a signature stays good, and what to sign. The API checks the plan, the hours and the setup first, so a refusal costs nothing. Pass `machine_id` and `hours` instead to price a renewal of a running machine (any wallet may pay one). Where the API sells quarter-hours (compute_plans shows minutePrices), send `minutes` (15, 30 or 45) in place of `hours`. For a plan that lists regions (compute_plans shows them), send `region`. To buy, sign one leg with your own wallet and send the same request with an X-PAYMENT header (compute_docs has the whole contract).",
      "inputSchema": {
        "additionalProperties": false,
        "properties": {
          "compose": {
            "description": "A docker-compose.yml as a string. It must publish a port. Or send image.",
            "type": "string"
          },
          "hours": {
            "description": "Prepaid hours (within the plan's range), or hours to add on a renewal. Or send minutes.",
            "minimum": 1,
            "type": "integer"
          },
          "image": {
            "description": "One container image, served on host port 8080, e.g. nginx:alpine. Or send compose.",
            "type": "string"
          },
          "machine_id": {
            "description": "Price a renewal of this machine instead of a new one (with hours or minutes only).",
            "type": "string"
          },
          "minutes": {
            "description": "In place of hours, where the API sells quarter-hours (compute_plans shows minutePrices): 15, 30 or 45 minutes, on every plan but GPU. A quarter-hour costs more per hour than an hour.",
            "enum": [
              15,
              30,
              45
            ],
            "type": "integer"
          },
          "plan": {
            "description": "A plan id from compute_plans. Not with machine_id.",
            "type": "string"
          },
          "port": {
            "description": "With image: the container port behind 8080 (default 80).",
            "maximum": 65535,
            "minimum": 1,
            "type": "integer"
          },
          "region": {
            "description": "For a plan that lists regions (compute_plans shows them): the region to run in, by its id. Absent, the plan's first.",
            "type": "string"
          }
        },
        "type": "object"
      },
