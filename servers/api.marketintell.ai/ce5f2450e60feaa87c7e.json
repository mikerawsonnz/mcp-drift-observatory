    {
      "annotations": {
        "destructiveHint": false,
        "idempotentHint": false,
        "openWorldHint": false,
        "readOnlyHint": false,
        "title": "Propose a trade intent (pending review)"
      },
      "description": "Propose a trade intent to the user's connected broker. Writes a pending row the user reviews + approves. Requires `trade` scope. Use this when an agent wants to act on a signal without placing the order itself.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "additionalProperties": false,
        "properties": {
          "asset_class": {
            "description": "Asset class — must match the broker's supportedAssetClasses",
            "enum": [
              "crypto_spot",
              "crypto_perp",
              "equity",
              "option"
            ],
            "type": "string"
          },
          "confidence": {
            "description": "Your confidence 0-1",
            "maximum": 1,
            "minimum": 0,
            "type": "number"
          },
          "limit_price": {
            "exclusiveMinimum": 0,
            "type": "number"
          },
          "notional_cents": {
            "description": "USD cents notional (preferred sizing — broker converts to qty)",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991,
            "type": "integer"
          },
          "order_type": {
            "default": "bracket",
            "enum": [
              "market",
              "limit",
              "bracket"
            ],
            "type": "string"
          },
          "qty": {
            "description": "Per-share / per-token qty (alternative to notional)",
            "exclusiveMinimum": 0,
            "type": "number"
          },
          "reasoning": {
            "description": "Plain-English rationale, surfaced to the user when they review the intent",
            "maxLength": 2000,
            "minLength": 20,
            "type": "string"
          },
          "side": {
            "description": "Direction",
            "enum": [
              "buy",
              "sell"
            ],
            "type": "string"
          },
          "signal_id": {
            "description": "MarketIntell TradeSignal ID, if this is acting on one",
            "type": "string"
          },
          "stop_price": {
            "exclusiveMinimum": 0,
            "type": "number"
          },
          "symbol": {
            "description": "Ticker / token, e.g. AAPL or BTC",
            "maxLength": 20,
            "minLength": 1,
            "type": "string"
          },
          "take_profits": {
            "items": {
              "additionalProperties": false,
              "properties": {
                "price": {
                  "exclusiveMinimum": 0,
                  "type": "number"
                },
                "qty_pct": {
                  "maximum": 100,
                  "minimum": 1,
                  "type": "number"
                }
              },
              "required": [
                "price",
                "qty_pct"
              ],
              "type": "object"
            },
            "type": "array"
          }
        },
        "required": [
          "symbol",
          "asset_class",
          "side",
          "reasoning",
          "confidence"
        ],
        "type": "object"
      },
      "name": "execute_propose_intent"
    },
