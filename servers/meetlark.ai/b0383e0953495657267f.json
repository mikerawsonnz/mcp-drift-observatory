    {
      "_meta": {
        "openai/toolInvocation/invoked": "Poll created!",
        "openai/toolInvocation/invoking": "Creating scheduling poll..."
      },
      "description": "Create a scheduling poll to find a time that works for a group. Returns an admin URL (keep private) and a participation URL (share with participants). The creator's email must be verified -- if not yet verified, a verification email is sent automatically. Ask the user to check their inbox and click the link, then retry.",
      "execution": {
        "taskSupport": "forbidden"
      },
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "properties": {
          "creatorEmail": {
            "description": "Email address of the poll creator",
            "type": "string"
          },
          "creatorName": {
            "description": "Name of the poll creator",
            "type": "string"
          },
          "description": {
            "description": "Additional context for participants",
            "type": "string"
          },
          "timeSlots": {
            "description": "Available time slots to vote on",
            "items": {
              "properties": {
                "date": {
                  "description": "Date in YYYY-MM-DD format",
                  "type": "string"
                },
                "endTime": {
                  "description": "End time in HH:MM format",
                  "type": "string"
                },
                "startTime": {
                  "description": "Start time in HH:MM format",
                  "type": "string"
                }
              },
              "required": [
                "date",
                "startTime",
                "endTime"
              ],
              "type": "object"
            },
            "type": "array"
          },
          "title": {
            "description": "What is this poll for?",
            "type": "string"
          }
        },
        "required": [
          "title",
          "timeSlots",
          "creatorEmail"
        ],
        "type": "object"
      },
      "name": "meetlark_create_poll"
    },
    {
      "_meta": {
        "openai/toolInvocation/invoked": "Poll details loaded!",
        "openai/toolInvocation/invoking": "Loading poll details..."
      },
      "description": "Get poll details and available time slots using a participation token. Returns the poll title, description, status, and time slots -- but NOT votes or participant data. This is the view a participant sees before voting. To see who voted and how, use meetlark_get_admin_view instead.",
      "execution": {
        "taskSupport": "forbidden"
      },
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "properties": {
          "participateToken": {
            "description": "The prt_xxx token from the participation URL",
            "type": "string"
          }
        },
        "required": [
          "participateToken"
        ],
        "type": "object"
      },
      "name": "meetlark_get_results"
    },
    {
      "_meta": {
        "openai/toolInvocation/invoked": "Vote recorded!",
        "openai/toolInvocation/invoking": "Submitting vote..."
      },
      "description": "Cast a vote on a scheduling poll. Each time slot can be voted yes, maybe, or no. Requires participant name and email. Use the participation token from the poll's participate URL. If the email matches a previous voter on this poll, their response is updated instead of creating a duplicate.",
      "execution": {
        "taskSupport": "forbidden"
      },
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "properties": {
          "email": {
            "description": "Participant's email address (required). Used to identify returning voters and send confirmation email.",
            "format": "email",
            "pattern": "^(?!\\.)(?!.*\\.\\.)([A-Za-z0-9_'+\\-\\.]*)[A-Za-z0-9_+-]@([A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$",
            "type": "string"
          },
          "name": {
            "description": "Name to display in results",
            "type": "string"
          },
          "participateToken": {
            "description": "The prt_xxx token from the participation URL",
            "type": "string"
          },
          "votes": {
            "description": "Votes for each time slot",
            "items": {
              "properties": {
                "timeSlotId": {
                  "description": "Time slot ID",
                  "type": "string"
                },
                "value": {
                  "description": "Vote value",
                  "enum": [
                    "yes",
                    "maybe",
                    "no"
                  ],
                  "type": "string"
                }
              },
              "required": [
                "timeSlotId",
                "value"
              ],
              "type": "object"
            },
            "type": "array"
          }
        },
        "required": [
          "participateToken",
          "name",
          "email",
          "votes"
        ],
        "type": "object"
      },
      "name": "meetlark_vote"
    },
