    {
      "annotations": {
        "openWorldHint": true,
        "readOnlyHint": true
      },
      "description": "Put a buyer's question to an AI assistant that searches the live web, and see whether a brand and its competitors are named in the answer, in what rank, with the citations and cited domains behind it. The assistant is ChatGPT unless `engine` names claude, perplexity or gemini; an assistant the server has no key for answers not_configured and costs nothing. `samples` (1 to 5, default 1) asks the same question more than once, for a mention rate. Returns metrics per assistant, not the raw answers. Charged per call to the assistant at the price list in credits (see llms.txt), the same as POST /v1/ai/answers: the worst case is held first, only the calls made are charged, and a call where the assistant failed is charged nothing. Gemini, when it searches Google, is a base price plus a price for each distinct search query it runs (the model decides how many; up to 10 a call are held for, and a call is only made when that worst case fits in what is held): you are charged for the queries that ran.",
      "inputSchema": {
        "properties": {
          "brand": {
            "description": "Brand name to look for in the answer",
            "title": "Brand",
            "type": "string"
          },
          "brand_domain": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "The brand's domain, for example roasters.ae",
            "title": "Brand Domain"
          },
          "competitors": {
            "anyOf": [
              {
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Competitor names or domains to track",
            "title": "Competitors"
          },
          "country": {
            "default": "ae",
            "description": "Two-letter ISO country code of the market",
            "title": "Country",
            "type": "string"
          },
          "engine": {
            "default": "chatgpt",
            "description": "The assistant to ask",
            "enum": [
              "chatgpt",
              "claude",
              "perplexity",
              "gemini"
            ],
            "title": "Engine",
            "type": "string"
          },
          "language": {
