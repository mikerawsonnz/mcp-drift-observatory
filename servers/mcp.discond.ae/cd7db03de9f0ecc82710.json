            "description": "Pagination cursor from a previous response meta.next_cursor",
            "maxLength": 512,
            "type": "string"
          },
          "lat": {
            "maximum": 90,
            "minimum": -90,
            "type": "number"
          },
          "limit": {
            "default": 10,
            "description": "Max results (1–25, default 10)",
            "maximum": 25,
            "minimum": 1,
            "type": "integer"
          },
          "lng": {
            "maximum": 180,
            "minimum": -180,
            "type": "number"
          },
