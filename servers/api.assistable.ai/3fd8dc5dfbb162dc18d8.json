    {
      "annotations": {
        "destructiveHint": false,
        "readOnlyHint": false
      },
      "description": "Create an assistant. Required: subAccountId, name. Optional config blocks (llmConfig, voiceConfig, chatConfig) mirror the dashboard create dialog. voice_settings configures call greeting mode, opening messages, and voicemail behavior; platform_tools attaches platform-catalog tools (declarative full-replace — see the field description).",
      "execution": {
        "taskSupport": "forbidden"
      },
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "properties": {
          "assistantType": {
            "enum": [
              "STANDARD",
              "FLOW_BUILDER"
            ],
            "type": "string"
          },
          "chatConfig": {
            "additionalProperties": {},
            "propertyNames": {
              "type": "string"
            },
            "type": "object"
          },
          "description": {
            "type": "string"
          },
          "llmConfig": {
            "properties": {
              "model": {
                "type": "string"
              },
              "prompt": {
                "type": "string"
              },
              "temperature": {
                "type": "number"
              }
            },
            "type": "object"
          },
          "name": {
            "type": "string"
          },
          "platform_tools": {
            "description": "Platform tool names to attach, e.g. [\"book_appointment\", \"send_email\"]. Declarative within the platform catalog: tools in the list are attached, catalog tools missing from the list are detached, custom tools are never touched. Omit for no change; [] detaches all platform tools. See GET /v3/tools for the catalog; custom tools attach via POST /v3/tools/{id}/assign.",
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "subAccountId": {
            "type": "string"
          },
          "voiceConfig": {
            "additionalProperties": {},
            "propertyNames": {
              "type": "string"
            },
            "type": "object"
          },
          "voiceId": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "voice_settings": {
            "properties": {
              "enable_voicemail_detection": {
                "description": "Records intent only: persisted and returned on read, but voicemail detection is currently platform-managed and this flag does not yet gate runtime behavior.",
                "type": "boolean"
              },
              "greeting_mode": {
                "description": "How the assistant opens a call: `dynamic` (AI-generated opener; default), `fixed` (speaks the configured opening message verbatim), or `contact_first` (stays silent until the contact speaks).",
                "enum": [
                  "dynamic",
                  "fixed",
                  "contact_first"
                ],
                "type": "string"
              },
              "inbound_opening_message": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ],
                "description": "Spoken opener for inbound calls. Only valid in `fixed` greeting mode. Template variables (e.g. a contact first-name placeholder) are allowed and resolve per call. `null` clears this direction."
              },
              "outbound_opening_message": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ],
                "description": "Spoken opener for outbound calls. Only valid in `fixed` greeting mode. Template variables are allowed and resolve per call. `null` clears this direction."
              },
              "voicemail_message": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ],
                "description": "Played when voicemail is detected, after which the assistant stops. Empty or `null` means the assistant hangs up on voicemail instead."
              }
            },
            "type": "object"
          }
        },
        "required": [
          "subAccountId",
          "name"
        ],
        "type": "object"
      },
      "name": "assistants_create"
    },
