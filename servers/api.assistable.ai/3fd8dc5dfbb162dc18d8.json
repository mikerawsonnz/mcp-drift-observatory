        ],
        "type": "object"
      },
      "name": "assistable_connect_finish"
    },
    {
      "annotations": {
        "destructiveHint": false,
        "readOnlyHint": false
      },
      "description": "Only when the person has no Assistable account (assistable_connect is for people who have one): start one with their email and name, and area_code or city/state for their local number. Emails them a 6-digit code; ask them for it, then call assistable_signup_finish. If they say the email told them they already have an account, use assistable_connect instead.",
      "execution": {
        "taskSupport": "forbidden"
      },
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "properties": {
          "area_code": {
            "description": "US area code for the account's phone number, e.g. 512.",
            "pattern": "^[2-9]\\d{2}$",
            "type": "string"
          },
          "business_name": {
            "description": "Their business, if the account is for one.",
            "maxLength": 120,
            "minLength": 1,
            "type": "string"
          },
          "city": {
            "description": "City for the phone number when no area code is given.",
            "maxLength": 80,
            "minLength": 1,
            "type": "string"
          },
          "client_name": {
            "description": "Your agent's name, shown in the email, e.g. Hermes.",
            "maxLength": 40,
            "minLength": 1,
            "pattern": "^[\\p{L} ']+$",
            "type": "string"
          },
          "email": {
            "description": "The person's email. The code goes there, and it becomes their login.",
            "format": "email",
            "maxLength": 254,
            "pattern": "^(?!\\.)(?!.*\\.\\.)([A-Za-z0-9_'+\\-\\.]*)[A-Za-z0-9_+-]@([A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$",
            "type": "string"
          },
          "name": {
            "description": "The person's full name.",
            "maxLength": 120,
            "minLength": 1,
            "type": "string"
          },
          "state": {
            "description": "US state, e.g. TX.",
            "maxLength": 40,
            "minLength": 2,
            "type": "string"
          }
        },
        "required": [
          "email",
          "name"
        ],
        "type": "object"
      },
      "name": "assistable_signup"
    },
    {
      "annotations": {
        "destructiveHint": false,
        "readOnlyHint": false
      },
      "description": "Finish assistable_signup with signup_id, the code the person read to you, and a strong password you generate and keep in your vault (it is their dashboard login). Returns api_key once: send it as the Authorization: Bearer header to this MCP server. Calls and texts answer card_required until the person opens card_url, which saves their card, adds starting credit and buys their local number; send them that link.",
      "execution": {
        "taskSupport": "forbidden"
