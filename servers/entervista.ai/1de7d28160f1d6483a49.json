                ],
                "type": "object"
              },
              "email": {
                "type": "string"
              },
              "name": {
                "type": "string"
              },
              "notes": {
                "type": "string"
              },
              "phone": {
                "type": "string"
              }
            },
            "type": "object"
          },
          "description": {
            "description": "The problem in the customer's words; used to match a service if service_sku is omitted",
            "type": "string"
          },
          "intake_answers": {
            "additionalProperties": {},
            "propertyNames": {
              "type": "string"
            },
            "type": "object"
          },
          "notes": {
            "type": "string"
          },
          "photos": {
            "description": "URLs (use upload_photo to turn an image into a URL)",
