          },
          "slogans": {
            "maxLength": 500,
            "type": "string"
          },
          "state_province": {
            "description": "Owner state or province.",
            "maxLength": 100,
            "type": "string"
          },
          "translation": {
            "description": "English translation of any non-English words in the mark.",
            "maxLength": 300,
            "type": "string"
          },
          "translation_language": {
            "description": "Language of the non-English words, e.g. Spanish.",
            "maxLength": 100,
            "type": "string"
          },
          "transliteration": {
            "description": "Transliteration of any non-Latin characters in the mark.",
            "maxLength": 300,
            "type": "string"
          }
        },
        "required": [
          "mark"
        ],
        "type": "object"
      },
