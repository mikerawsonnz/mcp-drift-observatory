        "readOnlyHint": false,
        "title": "Start a trademark application"
      },
      "description": "Start a US trademark application on Arcangel AI as a draft in the signed-in user's account. Pass what is known (the mark, goods or services, classes, owner); the rest can be added later with update_trademark_application. If a company owns the mark, pass the id of a saved company (list_companies) as company_id. Returns the draft id and what it still needs. Requires Sign in with Arcangel. Signing and payment happen on arcangel.ai.",
      "icons": [
        {
          "mimeType": "image/png",
          "sizes": [
            "750x750"
          ],
          "src": "https://www.arcangel.ai/apple-touch-icon.png"
        }
      ],
      "inputSchema": {
        "additionalProperties": false,
        "properties": {
          "acronym_meaning": {
            "description": "What the letters stand for, if the mark is an acronym.",
            "maxLength": 300,
            "type": "string"
          },
          "additional_statements": {
            "description": "Any other statement for the application.",
            "maxLength": 1000,
            "type": "string"
          },
          "address_line1": {
            "description": "Owner street address.",
            "maxLength": 200,
            "type": "string"
          },
          "address_line2": {
            "description": "Apartment, suite or unit.",
            "maxLength": 200,
            "type": "string"
          },
          "attorney_signs": {
            "description": "Whether the reviewing attorney should sign the application directly.",
            "type": "boolean"
          },
          "city": {
            "description": "Owner city.",
            "maxLength": 100,
            "type": "string"
          },
          "company_id": {
            "description": "Id of a saved company (list_companies) that owns the mark. Fills the company name, state of registration and address from the saved profile, so do not also send those. null unlinks it.",
            "type": [
              "string",
              "null"
            ]
          },
          "company_jurisdiction": {
            "description": "State or country where the company is organized, e.g. Delaware.",
            "maxLength": 100,
            "type": "string"
          },
          "company_name": {
            "description": "Company legal name, when a company owns the mark.",
            "maxLength": 200,
            "type": "string"
          },
          "country": {
            "description": "Owner country.",
            "maxLength": 100,
            "type": "string"
          },
          "disclaimer": {
            "description": "Words in the mark the owner does not claim on their own, e.g. a generic term like \"Coffee\".",
            "maxLength": 300,
            "type": "string"
          },
          "filing_basis": {
            "description": "use_in_commerce_1a: already selling under the mark. intent_to_use_1b: planning to.",
            "enum": [
              "use_in_commerce_1a",
              "intent_to_use_1b",
              "foreign_basis"
            ],
            "type": "string"
          },
          "first_use_date": {
            "description": "Date the mark was first used anywhere (YYYY-MM-DD).",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
            "type": "string"
          },
          "first_use_in_commerce_date": {
            "description": "Date the mark was first used in US interstate commerce (YYYY-MM-DD).",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
            "type": "string"
          },
          "goods_services": {
            "description": "The goods or services the mark is used for, in plain words.",
            "maxLength": 2000,
            "type": "string"
          },
          "mark": {
            "description": "The mark to apply for, e.g. \"Lumora\".",
            "maxLength": 120,
            "minLength": 1,
            "type": "string"
          },
          "mark_description": {
            "description": "For design or composite marks: describe the design elements.",
            "maxLength": 1000,
            "type": "string"
          },
          "mark_type": {
            "description": "word: text only. design: a logo with no words. composite: a logo that includes words.",
            "enum": [
              "word",
              "design",
              "composite"
            ],
            "type": "string"
          },
          "nice_classes": {
            "description": "Nice classes (1-45) to file in.",
