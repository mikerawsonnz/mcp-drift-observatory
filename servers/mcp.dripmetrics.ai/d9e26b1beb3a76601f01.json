      "description": "Paid via x402 ($0.05 per request). Computes empirical and/or normal parametric VaR for a crypto portfolio. Provide either weights + portfolioValueUsd, or quantities. Invalid portfolios fail before payment.",
      "execution": {
        "taskSupport": "forbidden"
      },
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "additionalProperties": false,
        "properties": {
          "assets": {
            "description": "Asset symbols, e.g. [\"BTC\", \"ETH\"].",
            "items": {
              "type": "string"
            },
            "minItems": 1,
            "type": "array"
          },
          "confidence": {
            "description": "Confidence level (default 0.95).",
            "maximum": 0.999,
            "minimum": 0.5,
            "type": "number"
          },
          "horizon": {
            "description": "Risk horizon, e.g. \"1d\" (default).",
            "type": "string"
          },
          "methods": {
            "description": "empirical, normal, or both (default).",
            "enum": [
              "empirical",
              "normal",
              "both"
            ],
            "type": "string"
          },
          "portfolioValueUsd": {
            "description": "Total portfolio value in USD.",
            "exclusiveMinimum": 0,
            "type": "number"
          },
          "quantities": {
            "description": "Asset quantities (alternative to weights).",
            "items": {
              "type": "number"
            },
            "type": "array"
          },
          "weights": {
            "description": "Portfolio weights (with portfolioValueUsd).",
            "items": {
              "type": "number"
            },
            "type": "array"
          },
          "window": {
            "description": "Price history window (default 180d).",
            "enum": [
              "90d",
              "180d"
            ],
            "type": "string"
          }
        },
        "required": [
          "assets"
        ],
        "type": "object"
      },
      "name": "compute_portfolio_var",
      "title": "Compute portfolio Value-at-Risk (paid)"
