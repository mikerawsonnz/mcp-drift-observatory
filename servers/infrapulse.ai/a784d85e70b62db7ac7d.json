      "description": "Create, inspect, or explicitly approve a private OAuth-bound InfraPulse connection. OAuth proves owner identity; requested InfraPulse operational scopes remain server-side and privileged scopes stay pending until the authenticated owner approves them.",
      "inputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "additionalProperties": false,
        "anyOf": [
          {
            "required": [
