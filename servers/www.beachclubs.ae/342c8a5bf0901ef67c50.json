        "title": "Search beach clubs"
      },
      "description": "Searches the BeachClubs.ae directory of beach clubs in the United Arab Emirates by name, hotel, area, emirate, family suitability, amenities and day pass price. Returns paginated club summaries with the BeachClubs.ae page link, a primary call-to-action link, price in AED (or a price-on-request note) and whether the club can be booked instantly on BeachClubs.ae.",
      "execution": {
        "taskSupport": "forbidden"
      },
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "additionalProperties": false,
        "properties": {
          "amenities": {
            "description": "Only clubs that list all of these amenities.",
            "items": {
              "enum": [
                "pool",
                "kids_area",
                "cabanas",
                "beach_bar",
                "pool_bar",
                "spa",
                "water_sports",
                "valet_parking",
                "wifi",
                "dj_live_music",
                "adults_only_area",
                "vip_area",
                "restaurant",
                "showers",
                "lockers"
              ],
              "type": "string"
            },
            "maxItems": 5,
            "type": "array"
          },
          "emirate": {
            "description": "Emirate filter. Accepts names, abbreviations (DXB, AD, AUH, SHJ, RAK, UAQ, FUJ) and Arabic names.",
            "maxLength": 50,
            "type": "string"
          },
          "family_friendly": {
            "description": "true returns only clubs with family-friendly listing status; false returns only adults-only listing status. Partial and empty statuses are excluded when set.",
            "type": "boolean"
          },
          "limit": {
            "default": 20,
            "description": "Number of results per page, 1 to 50. Default 20.",
            "maximum": 50,
            "minimum": 1,
            "type": "integer"
          },
          "max_day_pass_price": {
            "description": "Maximum day pass price in AED. Clubs whose price is on request are excluded when set.",
            "exclusiveMinimum": 0,
            "type": "number"
          },
          "offset": {
            "default": 0,
            "description": "Number of results to skip, for pagination. Default 0.",
            "minimum": 0,
            "type": "integer"
          },
          "query": {
            "description": "Free text matched against club name, hotel and area, typo tolerant. Words such as family, kids, pool, adults only, cheap or quiet and emirate names (including abbreviations like RAK or DXB and Arabic names) are applied as filters.",
            "maxLength": 200,
            "type": "string"
          }
        },
